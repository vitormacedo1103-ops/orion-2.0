# NUNCA preencha valores reais aqui. Copie para .env (local, ignorado pelo git)
# ou configure nas Environment Variables da Vercel (Production/Preview).

# Access Token PRIVADO do Mercado Pago (somente backend). Teste começa com APP_USR.
MERCADOPAGO_ACCESS_TOKEN=

# Secret do webhook (Your integrations > app > Webhooks). Usado para validar x-signature.
MERCADOPAGO_WEBHOOK_SECRET=

# Public Key (TEST-... em teste) exposta via /api/config — é pública por natureza.
MERCADOPAGO_PUBLIC_KEY=

# URL pública do site (produção). Ex: https://orionnexoficial.com
# Usada para validar Origin/Referer e montar links. Sem barra no final.
PUBLIC_SITE_URL=http://localhost:3000

# Ambiente: test | production (fail closed: qualquer outro valor = recusa)
MP_ENV=test

# Opcional (produção): persistência do processamento de webhooks via Upstash Redis REST.
# Sem isso, usa memória local (ok para teste; PERDE estado entre instâncias serverless).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
