# NUNCA preencha valores reais aqui. Copie para .env (local, ignorado pelo git)
# ou configure nas Environment Variables da Vercel (Production/Preview).

# Opcional: persistência de idempotência via Upstash Redis REST
# (reservado para o futuro webhook de confirmação; sem isso, usa memória local).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret do webhook Yampi (painel Yampi → Webhooks → chave secreta).
# Usado para validar o header X-Yampi-Hmac-SHA256. Nunca expor no frontend.
YAMPI_WEBHOOK_SECRET=
